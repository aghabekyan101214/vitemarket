# Copy to .env.prod and fill in. Never commit .env.prod.
# Keep comments on their own lines: "KEY=   # note" makes the note the value.

# --- image ---
API_IMAGE=ghcr.io/your-org/showcase-api
API_TAG=2026.11.11-abc1234

# --- app ---
LOG_LEVEL=INFO
LOG_FORMAT=json
# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
CORS_ALLOW_ORIGINS=https://admin.example.com
# Swagger UI / OpenAPI at /docs, /openapi.json (no data exposed; admin calls still need a token)
DOCS_ENABLED=true
# JSON request body limit (uploads have UPLOAD_MAX_BYTES)
MAX_REQUEST_BYTES=1048576
# Per client IP, per API process; pair with a Cloudflare rate-limit rule (runbook: deploy.md)
LOGIN_RATE_LIMIT_PER_MINUTE=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- postgres ---
POSTGRES_USER=showcase
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=showcase

# --- Cloudflare R2 (S3-compatible) ---
STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
# R2 API token: Object Read & Write, scoped to this bucket only
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=showcase-media
# Custom domain attached to the R2 bucket (public read, cached at the edge)
STORAGE_PUBLIC_BASE_URL=https://media.example.com
# "cloudflare" => image URLs use /cdn-cgi/image/<opts>/ on the media domain
IMAGE_TRANSFORM_PROVIDER=cloudflare
UPLOAD_MAX_BYTES=10485760
# Deleted images stay in the bucket this long (cached pages may still reference them)
MEDIA_RETENTION_DAYS=7
MEDIA_GC_INTERVAL_SECONDS=3600

# --- publishing ---
REVALIDATE_WEBHOOK_URL=https://frontend.example.com/api/revalidate
# openssl rand -hex 32 (shared with the Next.js app)
REVALIDATE_WEBHOOK_SECRET=
PUBLISH_DEBOUNCE_SECONDS=30
CDN_PURGE_PROVIDER=cloudflare
# API token with Zone > Cache Purge on every site zone
CLOUDFLARE_API_TOKEN=

# --- tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
